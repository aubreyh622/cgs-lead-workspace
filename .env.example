# Local workspace only. Values are read by the Python backend.
CGS_PORT=8766
CGS_DB_PATH=runtime/qualification.sqlite3
CGS_RESEARCH_DB_PATH=runtime/research.sqlite3

# Research: P1 uses the existing Gemini + Tavily adapter when a task is started.
# Checks/offline tests do not call providers. Set keys locally, then restart.
GEMINI_API_KEY=
# Where Gemini requests go (api/google_cloud.py):
#   ai_studio       AI Studio with GEMINI_API_KEY (default)
#   agent_platform  Google Cloud Agent Platform in CGS's project, signed by the service account or
#                   `gcloud auth application-default login`: no key. Set GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION.
#   express         Agent Platform express mode (free trial, @gmail.com): key in GOOGLE_GENAI_API_KEY
GEMINI_BACKEND=ai_studio
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# P4 AI feedback analysis uses the same Gemini key/model, without Tavily.
# Manual direction proposals need no model credentials and still require human approval.

# Existing qualification roles; separate configuration from research.
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Workspace v2 (FastAPI backend, Start Workspace v2.cmd) ----
# demo: no AI provider calls. live: real providers; errors are shown, never replaced by demo results.
APP_MODE=demo
# disabled | read_only (duplicate check only) | write_approved (also writes, only after a person's action).
CRM_MODE=disabled
# off | mock | insightly. Empty = mock in demo mode, off in live mode. Insightly credentials do NOT go in this file:
# put INSIGHTLY_API_KEY and INSIGHTLY_API_URL in %USERPROFILE%\.cgs-workspace\insightly.env. Names: config/crm.json.
CRM_PROVIDER=
CGS_V2_PORT=8800
CGS_V2_DB_PATH=runtime/workspace-v2.sqlite3
# Workspace users, comma-separated. On one computer there is no login: each person picks their name.
CGS_USERS=Alex Morgan,Sarah Patel,Daniel Brooks,Quinn Harper
# Who may act as Director of Operations at Step 8, comma-separated. Empty = any workspace user.
CGS_DIRECTORS=
# The first admins, comma-separated (api/people.py). Admins act as someone else, make other admins, change the scoring
# criteria, decide changes to the team's research direction, and change agent permissions, lessons and team instructions.
# Once an admin changes the roles on the People page, the workspace keeps its own list and this line is only the start.
# Empty = everyone may do admin work until someone is made an admin.
CGS_ADMINS=
# Keep the database outside OneDrive or other synced folders: syncing can damage a database in use.
# Use a separate file for demo and live mode; demo mode refuses a file that holds live records.

# ---- AI provider for the v2 agents ----
# gemini (default), openai or claude. To switch: change these two lines and add that company's key below.
AI_PROVIDER=gemini
# Empty = default model for the provider (gemini-3.5-flash-lite). Use a model your account can call.
AI_MODEL=
# GEMINI_API_KEY and OPENAI_API_KEY are set above. For claude (default model claude-haiku-5-5):
ANTHROPIC_API_KEY=
# Optional: a model for one agent instead of AI_MODEL (same AI company). Empty = AI_MODEL. Measure a change with
# Check Quality.cmd first. Example: AI_MODEL_OUTREACH=claude-sonnet-5-5
AI_MODEL_DISCOVERY=
AI_MODEL_DIRECTION=
AI_MODEL_RESEARCH=
AI_MODEL_OUTREACH=
AI_MODEL_EVIDENCE=
AI_MODEL_MANAGER=
# The step that reads each outreach draft against the CGS email standard (Settings, Email standard). Empty = the writer's model.
AI_MODEL_OUTREACH_REVIEW=
# Free Gemini tier: fine for synthetic demo data. Use a paid or CGS account before any real client data.

# ---- Autonomous agents ----
# on = agents patrol once a day and work through their task board in the background while the server runs.
# They only prepare drafts, facts and suggestions for people; nothing is sent or approved without a person.
AGENT_WORKER=on
# How many background jobs run at once (different opportunities in parallel). 1 = one at a time. Up to 8.
AGENT_LANES=3
# AI calls the agents may make per day on their own (also changeable in the workspace).
AGENT_AI_DAILY_BUDGET=60
# What runs each agent's steps (model turn -> tools -> answer check):
#   auto    Google's Agent Development Kit (ADK) when google-adk is installed (requirements.lock installs it), else legacy
#   adk     ADK (api/adk_runtime.py); stops with a clear error if google-adk is missing
#   legacy  the original hand-written loop (api/agent_runtime.py), kept as the reference ADK is measured against
# Both send the AI company the same requests and give the same results (tests/v2/test_adk_runtime.py, docs/ADK_EVAL.md).
AGENT_RUNTIME=auto
# How the workspace reaches the web, the CRM and Google Drive (cgs_tools/, docs/MCP_TOOLS.md):
#   inprocess  calls the connector code directly (default)
#   mcp        through the MCP tool servers cgs-search, cgs-insightly and cgs-drive (started over stdio, same answers)
TOOLS_TRANSPORT=inprocess
# on = send the agents' traces and metrics (no message text) to Cloud Trace / Cloud Monitoring. Hosted only:
# needs requirements-cloud.txt and a Google Cloud project (docs/DEPLOY_GOOGLE_CLOUD.md).
OTEL_TO_CLOUD=off
# Manager agent (looks over every open opportunity once a day; needs live mode):
#   off     does not run
#   shadow  decides, and every decision is recorded and compared with the rules (GET /api/manager/compare); nothing is queued
#   on      its delegations are queued for the agents and its notes go to the owners' inboxes; the rules keep running beside it
MANAGER_MODE=off
# Steps 2-3 company research: agent (the tool-using research agent, uses AI_PROVIDER) or pipeline
# (Aubrey's research pipeline on the real web, Gemini only; one AI request on the synthetic web).
RESEARCH_ENGINE=agent

# ---- CGS library for agents (K1 knowledge lookup, a small RAG) ----
# Put real CGS documents (.md or .txt) in the knowledge/ folder (subfolders too). python -m api.fetch_cgs_site fills
# knowledge/cgs-public/ from CGS's public website. auto = the SYNTHETIC demo library (api/seed/cgs_library_demo.json)
# is searched only while there are no real documents; on = always; off = never.
KNOWLEDGE_DEMO=auto
# Search: auto (default: hybrid when embeddings are set and the library has 40+ passages) | bm25 (keywords only) | hybrid.
# Meaning search needs an embeddings provider: gemini (GEMINI_API_KEY; recommended, CGS runs on Google), openai
# (OPENAI_API_KEY) or voyage (VOYAGE_API_KEY). Empty = keywords only.
# Only public pages and synthetic text are sent to it; private CGS documents need KNOWLEDGE_EMBED_PRIVATE=allowed (CGS OK first).
KNOWLEDGE_SEARCH=auto
KNOWLEDGE_EMBEDDINGS=gemini
# VOYAGE_API_KEY=
# CGS documents in Google Drive (api/toolkit/drive.py): off | mock | google. Empty = off. The library copies the Google
# Docs, .md and .txt files in DRIVE_FOLDER_IDS (folder ids or links, comma-separated) once a day, or on POST /api/drive/sync.
# Also switch the drive connector on (config/toolkit.json or the workspace). Sign in with Drive Sign In.cmd; on Google
# Cloud Run set DRIVE_AUTH=metadata and share the folders with the service account instead.
DRIVE_PROVIDER=
DRIVE_FOLDER_IDS=
# DRIVE_AUTH=oauth
# on = save the workspace's records (drafts, emails, notes, agent notes, decisions: one Google Doc per opportunity, and
# the activity log as a Google Sheet) to Drive, after a person's change and once a day (api/drive_records.py,
# docs/DATA_OWNERSHIP.md). Needs DRIVE_PROVIDER and the drive connector on. A Drive sign-in made before 2026-11-12 may
# only read: sign in again (Drive Sign In.cmd). On Cloud Run, use a folder in a shared drive the service account can edit.
DRIVE_RECORDS=off
# The folder (id or link) for the records. Empty = a folder "CGS Workspace Records" the workspace makes.
DRIVE_RECORDS_FOLDER_ID=

# ---- Email (shared toolkit mail connector, api/toolkit/mail.py) ----
# off | mock | gmail. Empty = mock in demo mode, off in live mode. gmail needs APP_MODE=live.
# Nothing is sent unless a person clicks Send (or sends the Gmail draft from Gmail).
MAIL_PROVIDER=
# Gmail credentials do NOT go in this file: this folder is synced and the token can read the whole mailbox.
# Put GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (an OAuth client of type "Desktop app") in
# %USERPROFILE%\.cgs-workspace\gmail.env, then run Gmail Sign In.cmd (python -m api.toolkit.gmail_auth); it saves
# GMAIL_REFRESH_TOKEN in that same file and never prints it. GMAIL_CREDENTIALS_FILE can point somewhere else.
# Client emails are CGS client data. An agent may read email threads only when this is "allowed" (SoW section 9)
# AND config/toolkit.json switches the mail connector on for that agent (see GET /api/toolkit).
CLIENT_DATA_TO_AI=off

# ---- Hosting on Google Cloud Run (docs/DEPLOY_GOOGLE_CLOUD.md). Leave all of these empty on one computer. ----
# The address the server listens on. 0.0.0.0 inside a container; then CGS_PUBLIC_HOSTS is required.
CGS_HOST=
# Host names people reach the hosted workspace by, comma-separated, for example cgs-workspace-xyz.a.run.app.
# The workspace has no login of its own: it must sit behind Google sign-in.
CGS_PUBLIC_HOSTS=
# PostgreSQL instead of the SQLite file (needs requirements-cloud.txt). On Cloud Run with Cloud SQL:
# postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE   Keep the real value in Secret Manager.
DATABASE_URL=
# Cloud Run sets PORT itself; it wins over CGS_V2_PORT.
# Google sign-in (needs requirements-cloud.txt). off = each person picks their name, as on one computer.
# google = the workspace sits behind Google's Identity-Aware Proxy and checks its signed note on every request.
# Then give each person's Google email in CGS_USERS:  CGS_USERS=Alex Morgan <alex@example.com>, Sarah Patel <sarah@example.com>
# and copy the audience from the IAP page into CGS_IAP_AUDIENCE.
CGS_LOGIN=
CGS_IAP_AUDIENCE=

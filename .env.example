# Local workspace only. Values are read by the Python backend.
CGS_PORT=8766
CGS_DB_PATH=runtime/qualification.sqlite3
CGS_RESEARCH_DB_PATH=runtime/research.sqlite3

# Research: P1 uses the existing Gemini + Tavily adapter when a task is started.
# Checks/offline tests do not call providers. Set keys locally, then restart.
GEMINI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# P4 AI feedback analysis uses the same Gemini key/model, without Tavily.
# Manual direction proposals need no model credentials and still require human approval.

# Existing qualification roles; separate configuration from research.
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Workspace v2 (FastAPI backend, Start Workspace v2.cmd) ----
# demo: no AI provider calls. live: real providers; errors are shown, never replaced by demo results.
APP_MODE=demo
# disabled | read_only | write_approved. Nothing is written to Insightly until CGS approves it.
CRM_MODE=disabled
CGS_V2_PORT=8800
CGS_V2_DB_PATH=runtime/workspace-v2.sqlite3
# Workspace users, comma-separated. There is no login yet: each person picks their name.
CGS_USERS=Alex Morgan,Sarah Patel,Daniel Brooks,Quinn Harper
# Who may act as Director of Operations at Step 8, comma-separated. Empty = any workspace user.
CGS_DIRECTORS=
# Keep the database outside OneDrive or other synced folders: syncing can damage a database in use.
# Use a separate file for demo and live mode; demo mode refuses a file that holds live records.

# ---- AI provider for the v2 agents ----
# gemini (default), openai or claude. To switch: change these two lines and add that company's key below.
AI_PROVIDER=gemini
# Empty = default model for the provider (gemini-3.5-flash-lite). Use a model your account can call.
AI_MODEL=
# GEMINI_API_KEY and OPENAI_API_KEY are set above. For claude (default model claude-haiku-5-5):
ANTHROPIC_API_KEY=
# Free Gemini tier: fine for synthetic demo data. Use a paid or CGS account before any real client data.

# ---- Autonomous agents ----
# on = agents patrol once a day and work through their task board in the background while the server runs.
# They only prepare drafts, facts and suggestions for people; nothing is sent or approved without a person.
AGENT_WORKER=on
# AI calls the agents may make per day on their own (also changeable in the workspace).
AGENT_AI_DAILY_BUDGET=60
# Manager agent (looks over every open opportunity once a day; needs live mode):
#   off     does not run
#   shadow  decides, and every decision is recorded and compared with the rules (GET /api/manager/compare); nothing is queued
#   on      its delegations are queued for the agents and its notes go to the owners' inboxes; the rules keep running beside it
MANAGER_MODE=off

# ---- CGS library for agents (K1 knowledge lookup, a small RAG) ----
# Put real CGS documents (.md or .txt) in the knowledge/ folder. While this is "on",
# the SYNTHETIC demo library (api/seed/cgs_library_demo.json) is searched too. Set it to off once real documents are in.
KNOWLEDGE_DEMO=on

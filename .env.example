# Local workspace only. Values are read by the Python backend.
CGS_PORT=8766
CGS_DB_PATH=runtime/qualification.sqlite3
CGS_RESEARCH_DB_PATH=runtime/research.sqlite3

# Research: P1 uses the existing Gemini + Tavily adapter when a task is started.
# Checks/offline tests do not call providers. Set keys locally, then restart.
GEMINI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# P4 AI feedback analysis uses the same Gemini key/model, without Tavily.
# Manual direction proposals need no model credentials and still require human approval.

# Existing qualification roles; separate configuration from research.
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Workspace v2 (FastAPI backend, Start Workspace v2.cmd) ----
# demo: no AI provider calls. live: real providers; errors are shown, never replaced by demo results.
APP_MODE=demo
# disabled | read_only | write_approved. Nothing is written to Insightly until CGS approves it.
CRM_MODE=disabled
CGS_V2_PORT=8800
CGS_V2_DB_PATH=runtime/workspace-v2.sqlite3
# Workspace users, comma-separated. There is no login yet: each person picks their name.
CGS_USERS=Alex Morgan,Sarah Patel,Daniel Brooks,Quinn Harper

# ---- AI provider for the v2 agents ----
# gemini (default) or openai. To switch: change these two lines and add that company's key below.
AI_PROVIDER=gemini
# Empty = default model for the provider (gemini-3.5-flash-lite). Use a model your account can call.
AI_MODEL=
# GEMINI_API_KEY and OPENAI_API_KEY are set above.
# Free Gemini tier: fine for synthetic demo data. Use a paid or CGS account before any real client data.

      "title": "Schema Version",
      "type": "string"
    },
    "brief_id": {
      "title": "Brief Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "capability": {
      "minLength": 10,
      "title": "Capability",
      "type": "string"
    },
    "problem": {
      "minLength": 20,
      "title": "Problem",
      "type": "string"
    },
    "industry": {
      "title": "Industry",
      "type": "string"
    },
    "geography": {
      "title": "Geography",
      "type": "string"
    },
    "signals": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Signals",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "excluded_domains": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Domains",
      "type": "array"
    },
    "buyer_roles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Buyer Roles",
      "type": "array"
    },
    "acceptable_sources": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Acceptable Sources",
      "type": "array"
    },
    "signal_max_age_days": {
      "default": 365,
      "maximum": 1825,
      "minimum": 1,
      "title": "Signal Max Age Days",
      "type": "integer"
    },
    "role_max_age_days": {
      "default": 180,
      "maximum": 730,
      "minimum": 1,
      "title": "Role Max Age Days",
      "type": "integer"
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approval_basis": {
      "default": "pending",
      "enum": [
        "pending",
        "mock",
        "cgs"
      ],
      "title": "Approval Basis",
      "type": "string"
    },
    "pipeline_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pipeline Owner"
    },
    "missing_contact_owner": {
      "default": "unconfirmed",
      "enum": [
        "identification",
        "downstream",
        "unconfirmed"
      ],
      "title": "Missing Contact Owner",
      "type": "string"
    }
  },
  "required": [
    "brief_id",
    "version",
    "capability",
    "problem",
    "industry",
    "geography",
    "signals",
    "exclusions",
    "buyer_roles",
    "acceptable_sources"

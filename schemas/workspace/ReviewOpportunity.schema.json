{
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "consultant_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Consultant Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "worth_exploring",
        "research_further",
        "defer"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason_code": {
      "enum": [
        "relevant_signal",
        "evidence_gap",
        "service_mismatch",
        "already_owned",
        "timing",
        "duplicate",
        "other"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "scope": {
      "enum": [
        "opportunity",
        "theme",
        "consultant",
        "cgs"
      ],
      "title": "Scope",
      "type": "string"
    },
    "comment": {
      "default": "",
      "maxLength": 4000,
      "title": "Comment",
      "type": "string"
    },
    "review_minutes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Minutes"
    },
    "source_support_checked": {
      "default": false,
      "title": "Source Support Checked",
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "revision",
    "consultant_id",
    "outcome",
    "reason_code",
    "scope"
  ],
  "title": "ReviewOpportunity",
  "type": "object"
}

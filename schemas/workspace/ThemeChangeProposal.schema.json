          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem"
        },
        "signals": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signals"
        },
        "buyer_roles": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Buyer Roles"
        },
        "exclusions": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusions"
        },
        "excluded_domains": {
          "anyOf": [
            {
              "items": {
                "maxLength": 160,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Domains"
        }
      },
      "title": "ResearchDirectionPatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "theme_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Theme Id",
      "type": "string"
    },
    "base_theme_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Base Theme Version",
      "type": "string"
    },
    "consultant_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Consultant Id",
      "type": "string"
    },
    "scope": {
      "enum": [
        "theme",
        "consultant",
        "cgs"
      ],
      "title": "Scope",
      "type": "string"
    },
    "feedback_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Feedback Ids",
      "type": "array"
    },
    "patch": {
      "$ref": "#/$defs/ResearchDirectionPatch"
    },
    "rationale": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "status": {
      "default": "pending_review",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "review_reason": {
      "default": "",
      "maxLength": 4000,
      "title": "Review Reason",
      "type": "string"
    },
    "resulting_theme_version": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resulting Theme Version"
    }

{
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "opportunity_revision": {
      "minimum": 1,
      "title": "Opportunity Revision",
      "type": "integer"
    },
    "status": {
      "enum": [
        "accepted",
        "needs_research",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "reviewer": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 4000,
      "title": "Reason",
      "type": "string"
    },
    "owner_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Id"
    },
    "next_action": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Action"
    },
    "due_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due Date"
    },
    "relationship_checked": {
      "default": false,
      "title": "Relationship Checked",
      "type": "boolean"
    },
    "relationship_note": {
      "default": "",
      "maxLength": 4000,
      "title": "Relationship Note",
      "type": "string"
    },
    "contact_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contact Index"
    }
  },
  "required": [
    "request_id",
    "opportunity_revision",
    "status",
    "reviewer"
  ],
  "title": "DecideHandoff",
  "type": "object"
}
